# Canvix — environment variables
#
# ── Database (required) ────────────────────────────────────────
# PostgreSQL OR MySQL. The URL prefix alone picks the provider:
#   postgres:// | postgresql://  → PostgreSQL (prisma/schema.prisma)
#   mysql://                     → MySQL 8   (prisma/schema.mysql.prisma)
# After switching between them, run `bun run db:generate` (the Prisma
# client is generated per provider).
#
# PostgreSQL — any Postgres server:
#   - local install:        postgresql://user:password@localhost:5432/canvix
#   - Docker:               postgresql://user:password@localhost:5432/canvix
#   - Neon (serverless):    postgresql://user:password@ep-xxxx.region.aws.neon.tech/canvix?sslmode=require
#   - Supabase / RDS / etc: same format
#
# MySQL — database must be utf8mb4 / utf8mb4_unicode_ci:
#   - local / shared host:  mysql://user:password@localhost:3306/canvix
#   (URL-encode special characters in the password, e.g. @ → %40)
#
# Local development quick-start (Docker):
#   docker run --name canvix-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=canvix -p 5432:5432 -d postgres:17
#   docker run --name canvix-mysql -e MYSQL_ROOT_PASSWORD=mysql -e MYSQL_DATABASE=canvix -p 3306:3306 -d mysql:8.0 \
#     --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
DATABASE_URL=postgresql://user:password@localhost:5432/canvix

# Only for `bun run db:copy-pg-to-mysql` (one-off PostgreSQL → MySQL data copy):
# PG_SOURCE_URL=postgresql://user:password@localhost:5432/canvix

# ── AI provider (optional) ─────────────────────────────────────
# Canvix works without any AI provider (local features keep working).
# When these are set, AI features (Magic Layers, Assistant, Magic Write,
# image generation/editing, translate, photo search) activate.
# Credentials are SERVER-SIDE ONLY — never exposed to the browser.
#
# Alternative: place a .z-ai-config JSON file on the server host:
#   { "baseUrl": "https://your-provider.example/v1", "apiKey": "your-key" }
# (checked at the working directory, then ~, then /etc)
#
# ZAI_BASE_URL=https://your-provider.example/v1
# ZAI_API_KEY=your-key

# ── AI agents / MCP server (optional, v0.6) ───────────────────
# Model Context Protocol endpoint: POST /api/mcp
# Lets AI assistants (Claude Desktop, Cursor, ChatGPT, any MCP client)
# create & edit real Canvix designs on this server. Disabled until
# you set a token; requests must send "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 24
# CANVIX_MCP_TOKEN=change-me-to-a-long-random-secret
